/* Carbon v1 · propiedades para importar en un tema Rasi de prueba. */
* {
    carbon-background: ${background};
    carbon-surface: ${surface};
    carbon-surface-raised: ${surfaceRaised};
    carbon-surface-alpha: ${surfaceAlpha};
    carbon-border: ${border};
    carbon-selection: ${selection};
    carbon-text: ${text};
    carbon-text-secondary: ${textSecondary};
    carbon-text-disabled: ${textDisabled};
    carbon-text-on-selection: ${textOnSelection};
    carbon-hover: ${hover};
    carbon-focus: ${focus};
    carbon-font: ${rasiFont};
    carbon-radius: ${radius};
    carbon-border-thin: ${borderThin};
    carbon-border-strong: ${borderStrong};
    carbon-space-unit: ${unit};
    carbon-space-small: ${small};
    carbon-space-medium: ${medium};
}
