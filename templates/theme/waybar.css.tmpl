* {
    font-family: ${fontFamily}, ${iconsSolid}, ${iconsBrands}, sans-serif;
    font-size: 12px;
    min-height: 0;
    border-radius: 0;
}

window#waybar {
    background: ${surface};
    color: ${text};
    border-bottom: 1px solid #292929;
}

#workspaces button {
    min-width: 23px;
    padding: 0 5px;
    color: ${textSecondary};
    background: transparent;
    border: 0;
    box-shadow: none;
    text-shadow: none;
}

#workspaces button:hover {
    background: #222222;
    color: #ffffff;
}

#workspaces button.active {
    background: ${selection};
    color: ${textOnSelection};
    font-weight: bold;
}

#workspaces button.urgent {
    box-shadow: inset 0 -2px ${selection};
    color: #ffffff;
}

#workspaces button.active.urgent {
    color: ${textOnSelection};
}

#network, #bluetooth, #pulseaudio, #backlight, #battery, #clock, #tray {
    padding: 0 7px;
}

#network.disconnected, #bluetooth.off, #bluetooth.disabled, #pulseaudio.muted {
    color: ${textDisabled};
}

#battery.charging, #battery.critical:not(.charging), #bluetooth.connected {
    color: ${selection};
}

#tray > .needs-attention image {
    -gtk-icon-effect: highlight;
}

#tray > .passive image {
    -gtk-icon-effect: dim;
}

tooltip {
    background: #151515;
    border: 1px solid ${border};
    color: ${text};
}

#custom-ai-usage {
    padding: 0 7px;
    border-radius: 0;
    border-left: 1px solid #292929;
    color: ${text};
    background: ${surface};
}

#custom-ai-usage.busy,
#custom-ai-usage.error {
    color: #4f9dff;
}
